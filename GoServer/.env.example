# Database Configuration
DATABASE_URL=postgres://webauthn:webauthn_password@localhost:5432/webauthn

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this

# WebAuthn Relying Party Configuration
RP_ID=localhost
RP_NAME=WebAuthn App
RP_ORIGIN=http://localhost:5173

# Server Configuration
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Environment Mode (DEV or PROD)
# DEV: Uses HTTP cookies (secure=false) for local development
# PROD: Uses HTTPS cookies (secure=true) for production
# Default: DEV
ENVIRONMENT=DEV

# Cookie Expiry Times (in seconds)
# Auth token expiry (default: 86400 = 24 hours)
AUTH_TOKEN_EXPIRY=86400

# WebAuthn session expiry (default: 300 = 5 minutes)
WEBAUTHN_SESSION_EXPIRY=300

# Admin Usernames (comma-separated, case-insensitive)
# Users with these usernames will be assigned ADMIN role during registration
# Example: ADMIN_USERNAMES=admin,superuser,dhanush
ADMIN_USERNAMES=

# GeoIP Database (optional - for location tracking)
# Download GeoLite2-City.mmdb from https://dev.maxmind.com/geoip/geoip2/geolite2/
# GEOIP_DB=GeoLite2-City.mmdb
