# Database
DATABASE_URL=postgres://webauthn:webauthn_password@localhost:5432/webauthn

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# WebAuthn Relying Party
RP_ID=localhost
RP_NAME=WebAuthn App
RP_ORIGIN=http://localhost:5173

# Server
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# GeoIP (optional - for location tracking)
# Download GeoLite2-City.mmdb from https://dev.maxmind.com/geoip/geoip2/geolite2/
# GEOIP_DB=GeoLite2-City.mmdb