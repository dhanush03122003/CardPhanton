# Database Configuration
DATABASE_URL=postgres://webauthn:webauthn_password@localhost:5432/webauthn

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this

# WebAuthn Relying Party Configuration
RP_ID=localhost
RP_NAME=WebAuthn App
RP_ORIGIN=http://localhost:5173

# Server Configuration
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Environment Mode (DEV or PROD)
# DEV: Uses HTTP cookies (secure=false) for local development
# PROD: Uses HTTPS cookies (secure=true) for production
# Default: DEV
ENVIRONMENT=DEV

# Cookie Expiry Times (in seconds)
# Auth token expiry (default: 86400 = 24 hours)
AUTH_TOKEN_EXPIRY=86400

# WebAuthn session expiry (default: 300 = 5 minutes)
WEBAUTHN_SESSION_EXPIRY=300

# Admin Usernames (comma-separated, case-insensitive)
# Users with these usernames will be assigned ADMIN role during registration
# Example: ADMIN_USERNAMES=admin,superuser,dhanush
ADMIN_USERNAMES=admin,superuser

# Background credit-limit job configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Email provider: imp or gmail_api
EMAIL_API=gmail_api
IMAP_HOST=imap.gmail.com:993
IMAP_APP_PASSWORD=
TEMPORAL_ADDRESS=localhost:7233


# Google OAuth Configuration for email parsing
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URL={CLIENT_ORIGIN}/google/callback
FRONTEND_REDIRECT_URL={CLIENT_ORIGIN}/dashboard?tab=consents
# Legacy unused key; Google OAuth uses GOOGLE_CLIENT_SECRET above.
client_secret=
# GeoIP Database (optional - for location tracking)
# Download GeoLite2-City.mmdb from https://dev.maxmind.com/geoip/geoip2/geolite2/
# GEOIP_DB=GeoLite2-City.mmdb
